# careerfit-ai Environment Configuration
# Copy to .env and adjust as needed

# Application
APP_NAME=careerfit-ai
APP_VERSION=1.0.0
DEBUG=false

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=120
OLLAMA_MAX_RETRIES=2
# CPU-only alternative: OLLAMA_MODEL=qwen2.5:3b

# Embedding
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
# Optional local GPU embedding: EMBEDDING_DEVICE=cuda

# File storage
UPLOAD_DIR=/tmp/careerfit_ai/uploads
OUTPUT_DIR=/tmp/careerfit_ai/outputs
MAX_FILE_SIZE_MB=20
JOB_TTL_SECONDS=3600

# Thresholds
WEAK_SECTION_THRESHOLD=0.55
STRONG_SECTION_THRESHOLD=0.78
MAX_REWRITE_RETRIES=2

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
